{
  "entities": {
    "UserRole": {
      "title": "UserRole",
      "description": "Represents the security clearance level of a registered application user.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "The user's Google Account email address."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "viewer"],
          "description": "The authorization clearance level."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The server-rendered modification date-time."
        }
      },
      "required": ["email", "role", "updatedAt"]
    },
    "Member": {
      "title": "Member",
      "description": "Comprehensive profile record representing a church member/adherent.",
      "type": "object",
      "properties": {
        "lastName": { "type": "string" },
        "firstName": { "type": "string" },
        "middleName": { "type": "string" },
        "gender": { "type": "string" },
        "age": { "type": "integer" },
        "birthday": { "type": "string" },
        "address": { "type": "string" },
        "contactNumber": { "type": "string" },
        "email": { "type": "string" },
        "membershipStatus": { "type": "string" },
        "isBaptized": { "type": "boolean" },
        "baptismDate": { "type": "string" },
        "baptismExecutedBy": { "type": "string" },
        "baptismWitness1": { "type": "string" },
        "baptismWitness2": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["lastName", "firstName", "membershipStatus"]
    },
    "Network": {
      "title": "Network",
      "description": "Segment of active small-group clusters under SCOC.",
      "type": "object",
      "properties": {
        "networkName": { "type": "string" },
        "networkLeader": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["networkName", "networkLeader"]
    },
    "Ministry": {
      "title": "Ministry",
      "description": "Registered ministry departments in SCOC.",
      "type": "object",
      "properties": {
        "ministryName": { "type": "string" },
        "ministryHead": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ministryName", "ministryHead"]
    },
    "ChurchEvent": {
      "title": "ChurchEvent",
      "description": "A scheduled event/service log listed in administrative timelines.",
      "type": "object",
      "properties": {
        "eventName": { "type": "string" },
        "eventDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventName", "eventDate"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Unique entry documenting church member presence list during a scheduled service.",
      "type": "object",
      "properties": {
        "eventId": { 
          "type": "string",
          "description": "Reference to the event ID."
        },
        "presentMembers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of active member IDs marked present."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the log was last synchronized."
        }
      },
      "required": ["eventId", "presentMembers", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Unmodifiable system activity record documenting database operation trails.",
      "type": "object",
      "properties": {
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userEmail", "userName", "action", "timestamp"]
    }
  },
  "firestore": {
    "/userRoles/{userId}": {
      "schema": "UserRole",
      "description": "Individual clearance levels mapped to verified account emails."
    },
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Dossier profile registry for all church members."
    },
    "/networks/{networkId}": {
      "schema": "Network",
      "description": "Clusters catalog listing church network circles."
    },
    "/ministries/{ministryId}": {
      "schema": "Ministry",
      "description": "Departments managing church duties and roles."
    },
    "/events/{eventId}": {
      "schema": "ChurchEvent",
      "description": "Timeline schedules for active worship programs."
    },
    "/attendance/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Log catalog marking member roll call events."
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable telemetry log of active administrative events."
    }
  }
}
