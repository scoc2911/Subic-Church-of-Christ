rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isSignedIn() {
      return request.auth != null && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'); 
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'scoc2911@gmail.com' ||
        (exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'scoc2911@gmail.com';
    }

    match /userRoles/{userId} {
      allow read: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId || isAdmin());
      allow write: if isSuperAdmin();
    }

    match /members/{memberId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        // Required fields
        request.resource.data.keys().hasAll(['lastName', 'firstName', 'membershipStatus', 'createdAt', 'updatedAt']) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() &&
        request.resource.data.keys().hasAll(['lastName', 'firstName', 'membershipStatus', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /networks/{networkId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(['networkName', 'networkLeader', 'createdAt', 'updatedAt']) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() &&
        request.resource.data.keys().hasAll(['networkName', 'networkLeader', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /ministries/{ministryId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(['ministryName', 'ministryHead', 'createdAt', 'updatedAt']) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() &&
        request.resource.data.keys().hasAll(['ministryName', 'ministryHead', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(['eventName', 'eventDate', 'createdAt', 'updatedAt']) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() &&
        request.resource.data.keys().hasAll(['eventName', 'eventDate', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
  }
}
