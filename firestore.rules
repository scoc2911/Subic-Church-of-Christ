rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny gate
    match /{document=**} { allow read, write: if false; }

    function isSignedIn() {
      return request.auth != null && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'); 
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'scoc2911@gmail.com' ||
        (exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'scoc2911@gmail.com';
    }

    // Entity validator: AuditLogs
    function isValidAuditLog(data) {
      return data.keys().hasAll(['userEmail', 'userName', 'action', 'timestamp'])
        && data.userEmail is string && data.userEmail.size() <= 128
        && data.userName is string && data.userName.size() <= 128
        && data.action is string && data.action.size() <= 1000;
    }

    // Entity validator: Attendance
    function isValidAttendance(data) {
      return data.keys().hasAll(['eventId', 'presentMembers', 'updatedAt'])
        && data.eventId is string && data.eventId.size() <= 128
        && data.presentMembers is list;
    }

    // Entity validator: UserRole
    function isValidUserRole(data) {
      return data.role in ['admin', 'viewer', 'guest']
        && data.email is string && data.email.size() <= 128;
    }

    // Entity validator: Member
    function isValidMember(data) {
      return data.firstName is string && data.firstName.size() <= 128
        && data.lastName is string && data.lastName.size() <= 128
        && data.membershipStatus is string && data.membershipStatus.size() <= 64;
    }

    // Entity validator: Network
    function isValidNetwork(data) {
      return data.networkName is string && data.networkName.size() <= 128
        && data.networkLeader is string && data.networkLeader.size() <= 128;
    }

    // Entity validator: Ministry
    function isValidMinistry(data) {
      return data.ministryName is string && data.ministryName.size() <= 128
        && data.ministryHead is string && data.ministryHead.size() <= 128;
    }

    // Entity validator: Event
    function isValidEvent(data) {
      return data.eventName is string && data.eventName.size() <= 128
        && data.eventDate is string && data.eventDate.size() <= 128;
    }

    match /userRoles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Forbid self-assigning high privilege: user can write role provided it is exactly 'viewer'
      allow create: if isSignedIn() && request.auth.uid == userId && (request.resource.data.role == 'viewer' || isSuperAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /members/{memberId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.email.lower() == request.auth.token.email.lower());
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 10);
      // Verified users can submit a new registration profile
      allow create: if isSignedIn() && (isAdmin() || request.resource.data.email.lower() == request.auth.token.email.lower()) && isValidMember(request.resource.data);
      allow update: if isAdmin() || (isSignedIn() && resource.data.email.lower() == request.auth.token.email.lower() && request.resource.data.email.lower() == request.auth.token.email.lower() && isValidMember(request.resource.data));
      allow delete: if isAdmin();
    }

    match /networks/{networkId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /ministries/{ministryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidAuditLog(request.resource.data);
    }
  }
}
